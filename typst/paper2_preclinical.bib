@article{shenChemicalModificationPSASO2019,
  title = {Chemical Modification of {{PS-ASO}} Therapeutics Reduces Cellular Protein-Binding and Improves the Therapeutic Index},
  author = {Shen, Wen and De Hoyos, Cheryl L. and Migawa, Michael T. and Vickers, Timothy A. and Sun, Hong and Low, Audrey and Bell, Thomas A. and Rahdar, Meghdad and Mukhopadhyay, Swagatam and Hart, Christopher E. and Bell, Melanie and Riney, Stan and Murray, Susan F. and Greenlee, Sarah and Crooke, Rosanne M. and Liang, Xue-hai and Seth, Punit P. and Crooke, Stanley T.},
  year = 2019,
  month = jun,
  journal = {Nature Biotechnology},
  volume = {37},
  number = {6},
  pages = {640--650},
  publisher = {Nature Publishing Group},
  issn = {1546-1696},
  doi = {10.1038/s41587-019-0106-2},
  urldate = {2026-05-02},
  abstract = {The molecular mechanisms of toxicity of chemically modified phosphorothioate antisense oligonucleotides (PS-ASOs) are not fully understood. Here, we report that toxic gapmer PS-ASOs containing modifications such as constrained ethyl (cEt), locked nucleic acid (LNA) and 2{$\prime$}-O-methoxyethyl (2{$\prime$}-MOE) bind many cellular proteins with high avidity, altering their function, localization and stability. We show that RNase H1--dependent delocalization of paraspeckle proteins to nucleoli is an early event in PS-ASO toxicity, followed by nucleolar stress, p53 activation and apoptotic cell death. Introduction of a single 2{$\prime$}-O-methyl (2{$\prime$}-OMe) modification at gap position 2 reduced protein-binding, substantially decreasing hepatotoxicity and improving the therapeutic index with minimal impairment of antisense activity. We validated the ability of this modification to generally mitigate PS-ASO toxicity with more than 300 sequences. Our findings will guide the design of PS-ASOs with optimal therapeutic profiles.},
  copyright = {2019 The Author(s), under exclusive licence to Springer Nature America, Inc.},
  langid = {english},
  keywords = {Antisense oligonucleotide therapy,Toxicology},
  file = {/Users/barneyh/Zotero/storage/PVV3D35L/Shen et al. - 2019 - Chemical modification of PS-ASO therapeutics reduces cellular protein-binding and improves the thera.pdf}
}

